{
  "name": "aurora-newtab",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:account-local": "node scripts/build.mjs --mode=account-local",
    "build:preview": "node scripts/build.mjs --mode=preview",
    "package": "npm run build && node scripts/package.mjs",
    "pretest": "node scripts/verify-photo-manifest.mjs",
    "test": "vitest run",
    "test:expansion-contract": "node scripts/expansion/run-contracts.mjs",
    "test:information-first-contract": "node --test scripts/preview-information-first.test.mjs",
    "test:widget-redesign-catalog": "node --test scripts/widget-redesign-catalog-contracts.test.mjs scripts/qa-widget-redesign-catalog.test.mjs",
    "test:watch": "vitest",
    "test:billing-return-site": "node --test scripts/billing-return-site-contract.test.mjs",
    "test:billing-return-production-contract": "node --test scripts/billing-return-production-contract.test.mjs",
    "store-shots": "node scripts/store-shots.mjs",
    "qa:information-first": "node scripts/preview-information-first.mjs",
    "qa:widget-redesign-catalog": "node scripts/qa-widget-redesign-catalog.mjs",
    "qa:widget-redesign-production": "node scripts/qa-widget-redesign-production.mjs --exact",
    "qa:attention-signals": "node scripts/qa-attention-signals.mjs --exact",
    "qa:free-baseline": "node scripts/qa-free-baseline.mjs",
    "qa:account-sync-shell": "node scripts/qa-account-sync-shell.mjs",
    "qa:account-auth-local": "node scripts/qa-account-auth-local.mjs",
    "qa:account-auth-production": "node scripts/qa-account-auth-production.mjs",
    "qa:stripe-billing": "node scripts/qa-stripe-billing.mjs",
    "qa:billing-return-site": "node scripts/qa-billing-return-site.mjs",
    "qa:tab-two-v2-connectors": "node scripts/qa-tab-two-v2-connectors.mjs --exact",
    "qa:tab-two-v2-progress": "node scripts/qa-tab-two-v2-progress.mjs --exact",
    "qa:tab-two-metrics": "node scripts/qa-tab-two-metrics.mjs --exact",
    "qa:canvas-polish": "node scripts/qa-canvas-polish.mjs",
    "qa:weather-enrichment": "node scripts/qa-weather-enrichment.mjs",
    "verify:photos": "node scripts/verify-photo-manifest.mjs",
    "test:supabase-local": "supabase test db"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "supabase": "2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
